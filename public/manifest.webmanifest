{
  "name": "AJ Hub — Personal Launchpad",
  "short_name": "AJ Hub",
  "description": "AJ's quiet corner of the internet and personal launchpad.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "background_color": "#020403",
  "theme_color": "#020403",
  "orientation": "any",
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Portfolio", "short_name": "Portfolio", "url": "https://portfolio.ajhub.ca" },
    { "name": "GitHub", "short_name": "GitHub", "url": "https://github.com" },
    { "name": "Calendar", "short_name": "Calendar", "url": "https://calendar.google.com" }
  ]
}
